{
  "name": "voidbound",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "format": "prettier --write src scripts *.json *.ts *.js *.html *.md",
    "preview": "vite preview --host 127.0.0.1",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "test:construction": "node scripts/construction-smoke.mjs",
    "test:catalog": "node scripts/catalog-smoke.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "phaser": "^3.90.0",
    "pinia": "^3.0.0",
    "simplex-noise": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
